# ~/.config/systemd/user/comms-poller.service — one calendar poll per timer tick.
# Installed by bin/comms-units install (which also enables comms-poller.timer).
[Unit]
Description=calendar-communication: Google Calendar poll (claim requests, push replies)

[Service]
Type=oneshot
WorkingDirectory=%h/calendar-communication
ExecStart=%h/calendar-communication/.venv/bin/python %h/calendar-communication/comms_poller.py --once
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
