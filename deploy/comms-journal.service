# ~/.config/systemd/user/comms-journal.service — one-way calendar → Obsidian vault export (tools/journal_export.py).
# Installed by bin/comms-units install (which also enables comms-journal.timer). No-op unless journal_dir is set in comms.toml.
[Unit]
Description=calendar-communication: journal export (notes + finished threads → journal_dir vault)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/calendar-communication
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/calendar-communication/.venv/bin/python %h/calendar-communication/tools/journal_export.py
