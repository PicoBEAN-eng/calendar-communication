# calendar-communication — one file per container. Copy to comms.toml and fill in.
stream = "Woolly"                      # name shown in replies / channel meta
calendar_id = "xxxx@group.calendar.google.com"   # from: comms_poller.py --list-calendars
timezone = "Australia/Melbourne"

# inbox session (bin/inbox-session)
session_name = "Woolly inbox"          # the Remote Control name you tap on the phone
session_cwd = "/home/woollyworkplace/woolly-workplace"
permission_mode = "auto"               # auto | acceptEdits | default …
# route 2 (channels) flags; leave empty to run the session without the channel shim (route 3)
channel_flags = "--dangerously-load-development-channels server:comms"

poll_interval_seconds = 60
backfill_hours = 0                     # first run: how far back to sweep for requests (0 = from now)
reply_buzz = true                      # slide replied events to "now" + 1-min popup so the phone buzzes
reply_buzz_lead_minutes = 2
note_anchor_date = "2000-01-01"   # events on this date, or titled "Note: …", are context notes: never claimed

# paths (relative to this file)
spool_dir = "spool"
state_file = "state/poller_state.json"
token_file = "state/token.json"
client_secret_file = "state/client_secret.json"

# --- whiteboard turns + tier sequencing (2026-09-08) --------------------------------------
default_tier = "medium"          # flat default for a title with no explicit tier word (no topic inference)
tier_switch = "off"              # off | picker — the shim types the /model picker into the session's
                                 # tmux pane (session-only "s" confirm) before a turn whose tier differs.
                                 # Verified mid-session model+effort switching keeps the transcript;
                                 # the picker keystroke sequence itself still needs its rehearsal run
                                 # (bin/tier-switch-test) before turning this on.
turn_timeout_minutes = 45        # a turn with no done/question reply after this admits the next
tier_order = ["low", "medium", "high"]   # queue order (same-as-current tier always first)

[tiers]                          # model = /model picker row name; effort = low|medium|high|xhigh|max
low    = { model = "haiku",  effort = "low" }
medium = { model = "sonnet", effort = "medium" }
high   = { model = "opus",   effort = "high" }
