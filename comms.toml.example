# calendar-communication — one instance per machine/container. Copy to comms.toml and fill in.
# Everything that identifies THIS instance lives here; the code is stream-agnostic.

stream = "Studio"                       # the stream's name: calendar name, reply signature, channel meta
calendar_id = "xxxx@group.calendar.google.com"   # from: comms_poller.py --list-calendars
timezone = "UTC"                        # IANA zone for reply timestamps and the reply buzz

# --- inbox session (bin/inbox-session) ---------------------------------------------------
session_name = "Studio inbox"           # the Remote Control name you tap in the Claude app
session_cwd = "/home/me/studio-project" # the project the session works in (already trusted by claude)
permission_mode = "auto"                # auto | acceptEdits | default … (auto = unattended work)
# The channel shim is loaded with the research-preview flag; leave as is unless Anthropic
# approves a plugin form of this channel (then e.g. "--channels plugin:comms@…").
channel_flags = "--dangerously-load-development-channels server:comms"

# --- replies -----------------------------------------------------------------------------
reply_buzz = true                       # slide a replied event to "now" with a popup so the phone buzzes
reply_buzz_lead_minutes = 1             # the popup fires this many minutes after the reply lands
reply_buzz_popup_minutes = 10           # one popup of this length (lingers instead of auto-dismissing)
note_anchor_date = "2000-01-01"         # events on this date, or titled "Note: …", are context notes: never claimed
wakeup_ritual = false                   # true: tools/wakeup.py writes the daily welcome note, outstanding digest and stray rescue on this calendar
# mirror_dir = "/home/you/vault-or-relay-space"   # set: tools/mirror.py mirrors notes carrying mirror_path two-way into this directory (comms-mirror.timer, settle loop)
# journal_dir = "/home/you/calendar-journal"   # set: tools/journal_export.py renders Note: events + finished threads into this Obsidian vault (one-way, 15-min timer)
backfill_hours = 0                      # very first poll only: how far back to look for requests (0 = from now)

# --- gear (model + effort) and the sequencer ---------------------------------------------
default_model = "default"               # gear for an event that names neither half: /model picker row name
default_effort = "medium"               #   default | opus-1m | fable | sonnet | opus  ×  low | medium | high | xhigh | max
gear_switch = "off"                     # off | picker — the shim drives the /model picker in the session's tmux
                                        # pane before a turn whose gear differs (session-only confirm).
                                        # Run bin/gear-switch-test on this machine before turning it on.
turn_timeout_minutes = 45               # a turn with no done/question reply after this admits the next
effort_order = ["low", "medium", "high", "xhigh", "max"]   # queue order (same-as-current gear first)

# --- paths (relative to this file) --------------------------------------------------------
spool_dir = "spool"
state_file = "state/poller_state.json"
token_file = "state/token.json"
client_secret_file = "state/client_secret.json"
