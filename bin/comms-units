#!/usr/bin/env bash
# Install / refresh / remove the two user-level systemd units.   bin/comms-units install|status|remove
# Assumes the package is checked out at ~/calendar-communication (the unit files say %h/calendar-communication).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dst="$HOME/.config/systemd/user"
units="comms-poller.service comms-poller.timer comms-inbox.service"
case "${1:-status}" in
  install)
    mkdir -p "$dst"
    # retire the pre-v1 unit names if they are still around
    for old in nexus-comms-poller.timer nexus-comms-poller.service nexus-comms-inbox.service; do
      if [ -f "$dst/$old" ]; then systemctl --user disable --now "$old" 2>/dev/null || true; rm -f "$dst/$old"; echo "retired $old"; fi
    done
    for u in $units; do cp "$here/deploy/$u" "$dst/$u"; done
    systemctl --user daemon-reload
    systemctl --user enable --now comms-poller.timer comms-inbox.service
    echo "installed: $units" ;;
  remove)
    systemctl --user disable --now comms-poller.timer comms-inbox.service 2>/dev/null || true
    for u in $units; do rm -f "$dst/$u"; done
    systemctl --user daemon-reload; echo "removed" ;;
  status)
    systemctl --user list-timers comms-poller.timer --no-pager | sed -n 1,2p
    systemctl --user is-active comms-inbox.service && journalctl --user -u comms-inbox.service -n 3 --no-pager ;;
  *) echo "usage: comms-units install|status|remove" >&2; exit 2 ;;
esac
