#!/usr/bin/env bash
# relay-reply <event_id> done|question "<text>"
# Queue a reply for the poller without the channel tool (route 3, or by hand).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
spool="${RELAY_SPOOL:-$here/spool}"
[ $# -eq 3 ] || { echo "usage: relay-reply <event_id> done|question \"<text>\"" >&2; exit 2; }
case "$2" in done|question) ;; *) echo "status must be done|question" >&2; exit 2;; esac
mkdir -p "$spool/outbox"
python3 - "$1" "$2" "$3" "$spool/outbox" <<'EOF'
import json, os, sys, datetime
eid, status, text, outbox = sys.argv[1:5]
tmp = os.path.join(outbox, f".{eid}.json.tmp"); out = os.path.join(outbox, f"{eid}.json")
with open(tmp, "w") as f:
    json.dump({"event_id": eid, "status": status, "text": text,
               "replied_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}, f, indent=1, ensure_ascii=False)
os.replace(tmp, out)
print(f"queued {status} reply for {eid} -> {out}")
EOF
