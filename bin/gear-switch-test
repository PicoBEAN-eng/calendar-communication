#!/usr/bin/env bash
# Rehearse the shim's gear switch against a SCRATCH Claude Code session (never the live inbox).
#
#   bin/gear-switch-test [model] [effort]      e.g.  bin/gear-switch-test haiku low
#   models: default opus-1m fable sonnet haiku opus   effort: low medium high xhigh max
#
# Drives exactly what the shim drives: gear_switch.mjs (parse-and-verify /model picker,
# session-only "s" confirm, answers the "Switch model?" dialog). Verified facts (2.1.259,
# 2026-09-08/09): mid-session model+effort switches keep the transcript; typed "/model x" /
# "/effort x" save the user's default (never used); the picker row list varies (5 or 6 rows)
# and wraps, hence parse-and-verify. Watch live: tmux attach -t comms-gear-test
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODEL="${1:-haiku}"; EFFORT="${2:-low}"
S=comms-gear-test
CWD="${COMMS_TEST_CWD:-$(python3 -c 'import tomllib;print(tomllib.load(open("'"$here"'/comms.toml","rb")).get("session_cwd","."))')}"   # an already-trusted folder (no trust dialog)
NODE_BIN="$(command -v node || echo "$HOME/.local/bin/node")"
snap() { echo "=== $1"; tmux capture-pane -p -t $S | grep -v '^\s*$' | tail -"${2:-8}"; }
settings="$HOME/.claude/settings.json"; before="$(stat -c %Y "$settings" 2>/dev/null || echo 0)"

tmux kill-session -t $S 2>/dev/null
tmux new-session -d -s $S -x 180 -y 45 -c "$CWD" "claude --permission-mode auto --model sonnet --effort medium"
sleep 12
tmux send-keys -t $S Escape; sleep 1     # dismiss any first-run dialog that would eat keystrokes
tmux send-keys -t $S "Remember the code word PELICAN. Reply with one word: ok." Enter; sleep 20; snap turn-1 5
tmux send-keys -t $S Escape; sleep 1

echo "=== switching to $MODEL / $EFFORT"
"$NODE_BIN" "$here/gear_switch.mjs" "$S" "$MODEL" "$EFFORT"; rc=$?
snap "after switch" 6

tmux send-keys -t $S "What was the code word? One word." Enter; sleep 25
echo "=== transcript check"
tmux capture-pane -p -t $S -S -300 | grep -E 'What was the code word' -A2 | tail -3
if tmux capture-pane -p -t $S -S -300 | grep -A2 'What was the code word' | grep -q PELICAN; then echo "transcript KEPT (PELICAN answered after the switch)"; else echo "transcript check INCONCLUSIVE (no PELICAN in the answer)"; rc=1; fi
echo "switch exit code: $rc (0 = verified)"
echo "expected: $MODEL with $EFFORT effort · transcript kept if PELICAN came back"
echo "settings.json modified by the test: $([ "$(stat -c %Y "$settings" 2>/dev/null || echo 0)" != "$before" ] && echo YES — the sequence saved a default, fix before enabling gear_switch || echo no)"
tmux kill-session -t $S
exit $rc
